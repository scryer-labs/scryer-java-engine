#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
./gradlew --no-daemon --console=plain -g "$root/.tooling/gradle" --project-cache-dir "$root/.tooling/project-cache" installDist
mkdir -p build/install/scryer-java-engine/bin build/install/scryer-java-engine/lib/java
rm -f build/install/scryer-java-engine/lib/java/*.jar
cp build/install/java-worker/lib/*.jar build/install/scryer-java-engine/lib/java/
# Remove standalone launchers left by earlier builds.
rm -f build/install/scryer-java-engine/bin/scryer-java-engine build/bin/scryer-java-engine
case "$(go env GOOS)" in
  darwin) extension=dylib ;;
  linux) extension=so ;;
  *) echo "Java engine ABI build supports macOS and Linux" >&2; exit 1 ;;
esac
library="build/install/scryer-java-engine/bin/libscryer-java-engine.$extension"
CGO_ENABLED=1 go build -trimpath -buildmode=c-shared -o "$library" ./cmd/java-engine-abi
rm -f "${library%.*}.h"
go run ./scripts/package-manifest > build/install/scryer-java-engine/engine.json
cp README.md LICENSE build/install/scryer-java-engine/
# Remove the obsolete JVM-only distribution after the renamed worker was assembled.
rm -rf build/install/scryer-java
